# ---------------------------------------------------------------------------
# Building RAG Pipelines — environment configuration (copy to `.env`)
# ---------------------------------------------------------------------------
# The pipeline is PROVIDER-AGNOSTIC. You change providers by editing the two
# *_PROVIDER variables below — no code changes. With NO keys at all, everything
# falls back to a deterministic offline "mock" so the material still runs.
# ---------------------------------------------------------------------------

# --- LLM (generation) provider: openai | anthropic | mock -------------------
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
# For Anthropic instead:  RAG_LLM_PROVIDER=anthropic  RAG_LLM_MODEL=claude-opus-4-8

# --- Embedding provider: openai | sentence-transformers | mock --------------
# NOTE: Anthropic has NO embeddings API. Use OpenAI (default) or local ST.
RAG_EMBED_PROVIDER=openai
RAG_EMBED_MODEL=text-embedding-3-small
# For local/free embeddings:  RAG_EMBED_PROVIDER=sentence-transformers
#                             RAG_EMBED_MODEL=all-MiniLM-L6-v2

# --- API keys (only needed for the matching provider) -----------------------
OPENAI_API_KEY=sk-...your-key-here...
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...
